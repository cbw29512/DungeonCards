{
  "name": "dungeon-cards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run export:dm-forge && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm test && npm run build",
    "sync:srd": "node scripts/srd/sync.mjs",
    "verify:srd": "node scripts/srd/verify-generated.mjs",
    "export:dm-forge": "node scripts/dm-forge/export-monster-summaries.mjs && node scripts/dm-forge/export-cleric-spells.mjs",
    "ingest:homebrew": "node scripts/homebrew/ingest-approved-sources.mjs config/homebrew-sources.json public/dm-forge/homebrew-index.json"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
